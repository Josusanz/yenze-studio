# Local development. Copy to .env; never commit actual keys.
APP_ORIGIN=http://localhost:3060
PORT=3061
HOST=127.0.0.1
# YENZE_DATA_DIR=/absolute/path/to/persistent-data
# Stripe Connect platform: use test mode first.
STRIPE_SECRET_KEY=
# Connect webhook secret, not an ordinary platform-only webhook.
STRIPE_WEBHOOK_SECRET=
# Optional transactional password-reset email.
RESEND_API_KEY=
MAIL_FROM=
# MCP stdio process (do not expose the token in browser code).
YENZE_API_URL=http://localhost:3061
YENZE_API_TOKEN=
# Optional photo-to-3D: operator explicitly enables selected workspace IDs.
MESHY_API_KEY=
MESHY_ORGANIZATIONS=
# Production requires a verified customer email before Stripe checkout by default.
# Local demos do not enforce this unless explicitly enabled.
# REQUIRE_VERIFIED_EMAIL=true
